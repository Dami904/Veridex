# ==============================================================================
# Veridex — Environment Configuration Template
# Copy to .env and populate with your credentials.
# ==============================================================================

# CockroachDB Cloud Connection String (PostgreSQL compatible)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?sslmode=verify-full
DATABASE_URL=postgresql://user:password@free-tier14.aws-us-east-1.cockroachlabs.cloud:26257/defaultdb?sslmode=verify-full

# AWS Credentials (for Amazon Bedrock Titan V2 Text Embeddings & S3 Paper Lake)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=veridex-paper-lake-54271
# Optional: AWS_SESSION_TOKEN=

# LLM Reasoning Provider Configuration (for Extractor, Arbiter & Synthesizer)
# Supported: gemini, openai, anthropic, or local_mock
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Live Deployment URLs
RENDER_BACKEND_URL=https://veridex-consensus-engine.onrender.com
VITE_API_URL=https://veridex-consensus-engine.onrender.com

# Server Configuration
PORT=4000
NODE_ENV=development
